---
import { enquiryOptions } from '../data/portfolio';
const options = enquiryOptions;
const defaultOption = options[0].title;
---

<div class="enquiry-select">
	<input class="enquiry-input" type="hidden" name="enquiry" value={defaultOption} />
	<button id="contact-enquiry" class="enquiry-trigger" type="button" role="combobox" aria-expanded="false" aria-haspopup="listbox" aria-controls="enquiry-options" aria-labelledby="contact-enquiry-label enquiry-value">
		<span id="enquiry-value">{defaultOption}</span>
		<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" /></svg>
	</button>
	<div id="enquiry-options" class="enquiry-options" popover="manual" role="listbox" aria-labelledby="contact-enquiry-label">
		{options.map((option, index) => (
			<div id={`enquiry-option-${index}`} class="enquiry-option" role="option" aria-selected={index === 0 ? 'true' : 'false'} data-value={option.title}>
				<span class="option-copy"><span class="option-title">{option.title}</span><span class="option-description">{option.description}</span></span>
				<svg class="option-check" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3.5 8 3 3 6-6" stroke="currentColor" stroke-width="1.5" /></svg>
			</div>
		))}
	</div>
</div>

<script>
	import { mountComponents } from '../scripts/shared/mount';
	import { initEnquirySelect } from '../scripts/enquiry-select';
	mountComponents<HTMLElement>('.enquiry-select', initEnquirySelect, import.meta.hot);
</script>

<style>
	.enquiry-select {
		width: 100%;
		min-width: 0;
	}
	.enquiry-input {
		display: none;
	}
	.enquiry-trigger {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		width: 100%;
		min-height: 54px;
		padding: 16px 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: var(--color-text);
		font: inherit;
		font-size: 18px;
		line-height: 1.2;
		letter-spacing: -.04em;
		text-align: left;
		cursor: pointer;
		outline: none;
	}
	.enquiry-trigger svg {
		flex-shrink: 0;
		width: 16px;
		height: 16px;
		color: var(--color-muted);
		transition: transform 200ms cubic-bezier(.23,1,.32,1),color 150ms;
	}
	.enquiry-trigger[aria-expanded="true"] svg {
		transform: rotate(180deg);
		color: var(--color-text);
	}
	.enquiry-options {
		--ease-out: cubic-bezier(.23,1,.32,1);
		position: fixed;
		inset: auto;
		margin: 0;
		padding: 6px;
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		scrollbar-color: #555 transparent;
		border: 1px solid rgb(242 241 237 / .12);
		border-radius: 8px;
		background: #272727;
		color: var(--color-text);
		box-shadow: 0 12px 40px rgb(10 10 10 / .35);
		opacity: 0;
		transform: translateY(-4px) scale(.98);
		transform-origin: top center;
		transition: opacity 180ms var(--ease-out),transform 180ms var(--ease-out),display 180ms allow-discrete,overlay 180ms allow-discrete;
	}
	.enquiry-options[data-side="top"] {
		transform-origin: bottom center;
	}
	.enquiry-options:popover-open {
		opacity: 1;
		transform: translateY(0) scale(1);
	}
	@starting-style {
		.enquiry-options:popover-open {
			opacity: 0;
			transform: translateY(-4px) scale(.98);
		}
	}
	.enquiry-option {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		min-height: 68px;
		padding: 12px;
		border-radius: 4px;
		cursor: pointer;
		transition: background-color 120ms;
	}
	.enquiry-option[data-active] {
		background: #373737;
	}
	.option-copy {
		display: flex;
		flex-direction: column;
		gap: 5px;
		min-width: 0;
	}
	.option-title {
		font-size: 14px;
		line-height: 1.3;
		letter-spacing: -.025em;
		font-weight: 500;
	}
	.option-description {
		color: var(--color-muted);
		font-size: 11px;
		line-height: 1.45;
	}
	.option-check {
		flex-shrink: 0;
		opacity: 0;
	}
	.enquiry-option[aria-selected="true"] .option-check {
		opacity: 1;
	}
	@media (max-width:600px) {
		.enquiry-trigger {
			min-height: 44px;
			padding: 10px 0;
			font-size: 16px;
		}
		.enquiry-option {
			min-height: 76px;
			gap: 8px;
			padding: 12px;
		}
		.option-description {
			font-size: 12px;
		}
	}
	@media (prefers-reduced-motion:reduce) {
		.enquiry-options,.enquiry-trigger svg {
			transition: none;
		}
	}
	@media (forced-colors:active) {
		.enquiry-trigger:focus-visible {
			outline: 2px solid Highlight;
		}
		.enquiry-option[data-active] {
			outline: 1px solid Highlight;
		}
	}
</style>
