---
import { profile, navigationItems } from '../data/portfolio';
import RoleRotator from './RoleRotator.astro';
import ExpertiseTicker from './ExpertiseTicker.astro';
import ArrowIcon from './icons/ArrowIcon.astro';
---

<header class="site-header">
	<div class="backdrop" aria-hidden="true"></div>
	<div class="header-row">
		<RoleRotator />
		<button class="contact-link" type="button" data-contact-open aria-haspopup="dialog" aria-controls="contact-dialog"><span class="contact-label">Let’s talk</span><span class="arrow-pill" aria-hidden="true">{[0, 1].map(() => <ArrowIcon />)}</span></button>
		<div class="panel-position">
			<div class="menu-panel">
				<div class="panel-heading">
					<a class="brand" href="#home" aria-label={profile.name + " — home"}>{profile.name}</a>
					<div class="panel-actions">
						<button class="mobile-contact" type="button" data-contact-open aria-haspopup="dialog" aria-controls="contact-dialog"><span>Let’s talk</span></button>
						<button class="menu-toggle" type="button" aria-controls="navigation-menu" aria-expanded="false" aria-label="Open menu">
							<svg class="menu-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path class="icon-line icon-line-top" stroke="currentColor" stroke-width="1.5" d="M8 13.5h16" /><path class="icon-line icon-line-bottom" stroke="currentColor" stroke-width="1.5" d="M8 18.5h16" /></svg>
						</button>
					</div>
				</div>
				<div id="navigation-menu" class="menu-content" aria-hidden="true" inert>
					<nav class="menu-links" aria-label="Main navigation">{navigationItems.map(({ label, href }) => (
						<a href={href} data-contact-open={label === 'Contact' ? true : undefined} aria-haspopup={label === 'Contact' ? 'dialog' : undefined}><ArrowIcon /><span>{label}</span></a>
					))}</nav>
					<ExpertiseTicker />
				</div>
			</div>
		</div>
	</div>
</header>

<script>
	import { mountComponents } from '../scripts/shared/mount';
	import { initNavigation } from '../scripts/navigation';
	mountComponents('.site-header', initNavigation, import.meta.hot);
</script>

<style>
	.site-header {
		--ease-panel: cubic-bezier(.35,0,.35,1);
		--ease-button: cubic-bezier(.66,.01,.12,.98);
		--ink: var(--color-text);
		position: fixed;
		inset: 0 0 auto;
		z-index: 40;
		pointer-events: none;
		color: var(--ink);
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	button {
		color: inherit;
		font: inherit;
		cursor: pointer;
	}
	.header-row {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 44px;
		margin: 20px 32px;
	}
	.backdrop {
		position: fixed;
		inset: 0;
		background: var(--color-overlay);
		backdrop-filter: blur(8px);
		opacity: 0;
		visibility: hidden;
		transition: opacity 350ms linear,visibility 350ms;
	}
	.menu-open .backdrop {
		pointer-events: auto;
		opacity: 1;
		visibility: visible;
	}
	.menu-open .roles,.menu-open .contact-link {
		color: #f7f1e9;
	}
	.panel-position {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
	}
	.menu-panel {
		width: 224px;
		height: 44px;
		overflow: hidden;
		background: var(--color-surface);
		border-radius: 4px;
		pointer-events: auto;
		transition: width 500ms var(--ease-panel),height 500ms var(--ease-panel);
	}
	.menu-open .menu-panel {
		width: 680px;
		height: var(--open-height);
	}
	.panel-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 44px;
		padding: 0 6px 0 12px;
		border-bottom: 1px solid transparent;
	}
	.menu-open .panel-heading {
		border-color: var(--color-border);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0;
		font-size: 21.333px;
		font-weight: 600;
		line-height: 1;
		letter-spacing: -1.2px;
		white-space: nowrap;
	}
	.panel-actions {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.menu-toggle {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 32px;
		height: 32px;
		padding: 0;
		border: 0;
		border-radius: 2px;
		background: var(--color-control);
		transition: background-color 150ms cubic-bezier(.4,0,.2,1);
	}
	.menu-icon {
		width: 32px;
		height: 32px;
		transform: rotate(0deg);
		transition: transform 300ms var(--ease-button);
	}
	.icon-line {
		transform-origin: 16px 16px;
		transition: transform 300ms var(--ease-button);
	}
	.menu-open .menu-icon {
		transform: rotate(180deg);
	}
	.menu-open .icon-line-top {
		transform: rotate(45deg) translateY(2.5px);
	}
	.menu-open .icon-line-bottom {
		transform: rotate(-45deg) translateY(-2.5px);
	}
	.menu-content {
		width: 680px;
		max-height: calc(100dvh - 84px);
		overflow-x: hidden;
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		scrollbar-color: #555550 transparent;
		opacity: 0;
		transition: opacity 300ms;
	}
	.menu-open .menu-content {
		opacity: 1;
		transition-delay: 120ms;
	}
	.menu-links {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 23px 16px 27px;
	}
	.menu-links a {
		position: relative;
		display: block;
		width: 100%;
		padding: 9px 0;
		font-size: 32px;
		line-height: 1.1;
		letter-spacing: -.06em;
		font-weight: 500;
	}
	.menu-links a>span {
		display: block;
		width: fit-content;
		transition: transform 400ms var(--ease-button);
	}
	.menu-links a>svg {
		position: absolute;
		top: 50%;
		left: 0;
		height: .5em;
		width: auto;
		transform: translate(-33.333%,-50%);
		opacity: 0;
		transition: transform 400ms var(--ease-button),opacity 400ms var(--ease-button);
	}
	.contact-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		pointer-events: auto;
		padding: 0;
		border: 0;
		background: transparent;
		font-size: 16px;
		line-height: 1;
		font-weight: 500;
		transition: color 500ms;
	}
	.contact-label {
		border-bottom: 1px solid currentColor;
		padding-bottom: 3px;
	}
	.arrow-pill {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		width: 31px;
		height: 22px;
		border-radius: 999px;
		background: var(--color-text);
		color: var(--color-bg);
		transition: background-color 500ms,color 500ms;
	}
	.menu-open .arrow-pill {
		background: var(--color-text);
		color: var(--color-bg);
	}
	.arrow-pill svg {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 11px;
		height: 8px;
		transition: transform 400ms var(--ease-button);
	}
	.arrow-pill svg:nth-child(2) {
		transform: translateX(-150%) scale(0);
	}
	.mobile-contact {
		display: none;
		border: 0;
		background: transparent;
		padding: 0;
	}
	a:focus-visible,button:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 4px;
	}
	@media (hover:hover) and (pointer:fine) {
		.menu-toggle:hover {
			background: var(--color-control-hover);
		}
		.menu-links a:hover>span {
			transform: translateX(1em);
		}
		.menu-links a:hover>svg {
			opacity: 1;
			transform: translate(0,-50%);
		}
		.contact-link:hover .arrow-pill svg:first-child {
			transform: translateX(150%) scale(0);
		}
		.contact-link:hover .arrow-pill svg:nth-child(2) {
			transform: translateX(0) scale(1);
		}
	}
	.menu-links a:focus-visible>span {
		transform: translateX(1em);
	}
	.menu-links a:focus-visible>svg {
		opacity: 1;
		transform: translate(0,-50%);
	}
	@media (max-width:1023px) {
		.header-row {
			display: block;
			height: 56px;
			margin: calc(12px + env(safe-area-inset-top,0px)) 16px 12px;
		}
		.panel-position {
			width: 100%;
			max-width: 600px;
		}
		.menu-panel,.menu-open .menu-panel {
			width: 100%;
		}
		.menu-panel {
			height: 56px;
		}
		.panel-heading {
			height: 56px;
			padding: 0 6px 0 12px;
		}
		.brand {
			min-height: 44px;
			font-size: 18px;
			letter-spacing: -.65px;
		}
		.panel-actions {
			gap: 8px;
		}
		.menu-toggle {
			width: 44px;
			height: 44px;
			border-radius: 3px;
		}
		.mobile-contact {
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 44px;
			padding: 0 2px;
			border: 0;
			font-size: 12px;
			line-height: 1;
			white-space: nowrap;
		}
		.mobile-contact span {
			padding-bottom: 2px;
			border-bottom: 1px solid currentColor;
		}
		.contact-link {
			display: none;
		}
		.menu-content {
			width: 100%;
			max-height: calc(100dvh - 96px - env(safe-area-inset-top,0px));
		}
		.menu-links {
			padding: 20px;
		}
		.menu-links a {
			font-size: 28px;
			padding-block: 8px;
		}
		.roles {
			position: absolute;
			top: 64px;
			left: max(0px,calc((100% - 600px) / 2));
			font-size: 12px;
			transition: opacity 300ms;
		}
		.menu-open .roles {
			opacity: 0;
			pointer-events: none;
		}
	}
	@media (max-width:600px) {
		.header-row {
			margin: calc(12px + env(safe-area-inset-top,0px)) 20px 12px;
		}
		.roles {
			display: none;
		}
		.menu-panel {
			background: transparent;
		}
		.menu-open .menu-panel {
			background: var(--color-surface);
		}
		.panel-heading {
			display: grid;
			grid-template-columns: 44px minmax(0,1fr) 44px;
			padding: 0;
		}
		.brand {
			grid-column: 2;
			justify-self: center;
			font-size: 21px;
			letter-spacing: -.8px;
		}
		.panel-actions {
			grid-column: 3;
			gap: 0;
		}
		.mobile-contact {
			display: none;
		}
		.menu-toggle {
			background: transparent;
		}
		.menu-open .menu-toggle {
			background: var(--color-control);
		}
	}
	@media (max-width:360px) {
		.brand {
			font-size: 19px;
		}
	}
	@media (prefers-reduced-motion:reduce) {
		.menu-panel,.backdrop,.menu-content,.roles,.contact-link,.arrow-pill,.arrow-pill svg,.menu-links a>span,.menu-links a>svg,.menu-icon,.icon-line {
			transition-duration: 0s;
			transition-delay: 0s;
		}
	}
	@media print {
		.site-header {
			position: static;
		}
		.menu-toggle,.contact-link,.backdrop,.menu-content {
			display: none;
		}
	}
</style>
