---
import { profile } from '../data/portfolio';
const roles = profile.roles;
const { class: className, ...attributes } = Astro.props;
---

<div class:list={['roles', className]} {...attributes}>
	<span class="sr-only">{roles.join(', ')}</span>
	<div class="role-cycle" aria-hidden="true">
		{roles.map((role, index) => (
			<span class="role" style={`--index:${index}`}>{role}</span>
		))}
	</div>
</div>

<style>
	.roles {
		position: relative;
		display: flex;
		align-items: center;
		gap: 8px;
		pointer-events: auto;
		font-size: 15px;
		font-weight: 500;
		transition: color 500ms;
	}
	.role-cycle {
		display: grid;
		overflow: hidden;
		padding-block: 8px;
	}
	.role {
		grid-area: 1/1;
		white-space: nowrap;
		opacity: 0;
		animation: role-change 10.5s cubic-bezier(.23,1,.32,1) infinite;
		animation-delay: calc(var(--index) * 3.5s - .5s);
	}
	@keyframes role-change {
		0% {
			opacity: 0;
			filter: blur(5px);
			transform: translateY(35%);
		}
		4.76%,33.33% {
			opacity: 1;
			filter: blur(0);
			transform: translateY(0);
		}
		38.09%,100% {
			opacity: 0;
			filter: blur(5px);
			transform: translateY(-35%);
		}
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}
	@media (prefers-reduced-motion:reduce) {
		.role {
			animation: none;
			filter: none;
			transform: none;
			opacity: 0;
		}
		.role:first-child {
			opacity: 1;
		}
	}
	@media print {
		.role {
			animation: none;
			opacity: 0;
		}
		.role:first-child {
			opacity: 1;
		}
	}
</style>
