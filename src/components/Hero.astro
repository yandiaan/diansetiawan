---
import { profile } from '../data/portfolio';
import HeroShader from './HeroShader.astro';
import HeroPortrait from './HeroPortrait.astro';

---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero-composition">
		<h1 id="hero-title" data-hero-light aria-label="I turn ideas into software that works in the real world.">
			<span class="headline-line line-one" aria-hidden="true"><span class="line-reveal" data-light-ink>I turn ideas</span></span>
			<span class="headline-line line-two" aria-hidden="true"><span class="line-reveal visual-line"><span data-light-ink>into</span> <HeroPortrait /> <span class="software-word" data-light-ink>software</span></span></span>
			<span class="headline-line line-three" aria-hidden="true"><span class="line-reveal" data-light-ink>that works</span></span>
			<span class="headline-line line-four" aria-hidden="true"><span class="line-reveal" data-light-ink><span class="world-prefix">in the</span> <span class="world-suffix">real world.</span></span></span>
		</h1>
	</div>
	<HeroShader />
	<div class="hero-meta">
		<a class="expertise-link" href="#expertise"><span class="meta-desktop">Software / Blockchain / AI</span><span class="meta-mobile">Engineering</span></a>
		<time class="local-time" data-local-clock data-time-zone={profile.timeZone} aria-label="Current time in Jakarta">WIB · UTC+7</time>
		<button type="button" data-contact-open aria-haspopup="dialog" aria-controls="contact-dialog"><span class="meta-desktop">Let’s build together</span><span class="meta-mobile">Let’s talk</span><span aria-hidden="true">↗</span></button>
	</div>
</section>

<script>
	import { mountComponents } from '../scripts/shared/mount';
	import { initLocalClock } from '../scripts/local-clock';
	import { initHeroLight } from '../scripts/hero-light';
	mountComponents<HTMLTimeElement>('[data-local-clock]', initLocalClock, import.meta.hot);
	mountComponents<HTMLElement>('[data-hero-light]', initHeroLight, import.meta.hot);
</script>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-rows: 1fr auto;
		min-height: 100svh;
		padding: 120px 32px 30px;
	}
	.hero-composition {
		position: relative;
		z-index: 1;
		align-self: center;
		width: 100%;
		max-width: 1680px;
		margin: 0 auto;
		padding: 36px 0 68px;
	}
	h1 {
		margin: 0;
		font-size: clamp(64px,7.8vw,150px);
		font-weight: 750;
		line-height: 1.02;
		letter-spacing: -.06em;
		word-spacing: .025em;
	}
	.headline-line {
		display: block;
		overflow: hidden;
		padding-block: .04em;
		margin-block: -.04em;
	}
	.headline-line {
		text-align: left;
	}
	.line-one {
		margin-left: 29%;
	}
	.line-two {
		margin-left: 14%;
	}
	.line-three,.line-four {
		margin-left: 30%;
	}
	.line-reveal {
		display: block;
		animation: hero-enter 750ms cubic-bezier(.23,1,.32,1) both;
	}
	.line-two .line-reveal {
		animation-delay: 80ms;
	}
	.line-three .line-reveal {
		animation-delay: 160ms;
	}
	.line-four .line-reveal {
		animation-delay: 240ms;
	}
	.visual-line {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: .2em;
	}
	.visual-line > [data-light-ink] {
		/* Negative tracking lets the last glyph extend beyond the text box. */
		padding-inline-end: .08em;
		margin-inline-end: -.08em;
	}
	.hero-visual {
		display: inline-block;
		position: relative;
		flex-shrink: 0;
		width: 1.85em;
		height: .76em;
		margin-inline: .02em;
		overflow: hidden;
	}
	.hero-meta {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 24px;
		font-size: 10px;
		line-height: 1.5;
		font-weight: 700;
		letter-spacing: .14em;
		text-transform: uppercase;
	}
	.hero-meta a,.hero-meta button {
		color: inherit;
		text-decoration: none;
	}
	.hero-meta button {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 6px 0;
		border: 0;
		background: transparent;
		font: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
		cursor: pointer;
	}
	.hero-meta button span {
		font-size: 17px;
		line-height: 1;
	}
	.hero-meta button .meta-desktop,.hero-meta button .meta-mobile {
		font: inherit;
	}
	.meta-mobile {
		display: none;
	}
	.local-time {
		font-variant-numeric: tabular-nums;
	}
	a:focus-visible,button:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 6px;
	}
	@keyframes hero-enter {
		from {
			opacity: 0;
			transform: translateY(105%);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	@media (hover:hover) and (pointer:fine) {
		@supports (background-clip: text) {
			[data-light-ink] {
				background-image:
					radial-gradient(circle 210px at var(--light-x, -500px) var(--light-y, -500px),
						rgb(255 255 255 / var(--light-strength, 0)) 0%,
						rgb(239 250 246 / calc(var(--light-strength, 0) * .65)) 32%,
						rgb(239 250 246 / 0) 100%),
					linear-gradient(
						rgb(calc(242 - var(--light-strength, 0) * 64) calc(241 - var(--light-strength, 0) * 57) calc(237 - var(--light-strength, 0) * 55)),
						rgb(calc(242 - var(--light-strength, 0) * 64) calc(241 - var(--light-strength, 0) * 57) calc(237 - var(--light-strength, 0) * 55)));
				background-clip: text;
				-webkit-background-clip: text;
				color: transparent;
			}
		}
		.hero-meta a:hover,.hero-meta button:hover,.intro>a:hover {
			text-decoration: underline;
			text-underline-offset: 5px;
		}
	}
	@media (min-width:1800px) {
		.hero-composition {
			padding-bottom: 88px;
		}
	}
	@media (max-width:1023px) {
		.hero {
			min-height: auto;
			grid-template-rows: auto auto;
			gap: 56px;
			padding: 156px 24px 36px;
		}
		.hero-composition {
			padding: 0;
		}
		h1 {
			font-size: clamp(58px,8.2vw,90px);
		}
		.hero-meta {
			font-size: 10px;
			letter-spacing: .07em;
			gap: 16px;
		}
		.line-one {
			margin-left: 22%;
		}
		.line-two {
			margin-left: 10%;
		}
		.line-three,.line-four {
			margin-left: 24%;
		}
	}
	@media (max-width:600px) {
		.hero {
			min-height: max(100svh,480px);
			grid-template-rows: 1fr auto;
			gap: 0;
			padding: 0 20px calc(18px + env(safe-area-inset-bottom,0px));
		}
		.hero-composition {
			align-self: center;
			padding: 0;
			transform: translateY(-20px);
		}
		.headline-line {
			margin-left: 0;
			text-align: center;
		}
		h1 {
			font-size: 10.2vw;
			line-height: 1.02;
			letter-spacing: -.055em;
		}
		.headline-line {
			white-space: nowrap;
		}
		.hero-visual {
			width: 1.85em;
			height: .76em;
			margin: 0 .02em;
		}
		.visual-line {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: .12em;
		}
		.software-word {
			padding: 0;
		}
		.world-prefix,.world-suffix {
			display: inline;
		}
		.world-suffix {
			padding: 0;
		}
		.hero-meta {
			grid-template-columns: 1fr auto 1fr;
			gap: 8px;
			font-size: 8px;
			letter-spacing: .1em;
		}
		.meta-desktop {
			display: none;
		}
		.meta-mobile {
			display: inline;
		}
		.expertise-link {
			grid-column: auto;
			display: flex;
			align-items: center;
			min-height: 44px;
		}
		.local-time {
			justify-self: center;
			color: var(--color-text);
		}
		.hero-meta button {
			grid-column: auto;
			justify-self: end;
			min-height: 44px;
			gap: 6px;
		}
		.hero-meta button>span[aria-hidden] {
			font-size: 12px;
		}
	}
	@media (max-width:360px) {
		h1 {
			font-size: 10vw;
		}
	}
	@media (prefers-reduced-motion:reduce) {
		.line-reveal {
			animation: none;
		}
	}
</style>
